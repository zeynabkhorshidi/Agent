# development فقط داده آزمایشی؛ production عمداً تا اتصال سرویس‌ها مسدود است.
SELLORA_ENV=development
SELLORA_DB=data/sellora.db
SELLORA_ADMIN_PASSWORD=
COOKIE_SECURE=false
# تنها سمت سرور؛ پروتکل و مسیر مشخص نیست. به صورت خودکار استفاده نمی‌شوند.
VOICE_DEV_ADDRESS=172.20.3.81:30089
VOICE_PROD_ADDRESS=172.20.4.81:30081
VOICE_MODE=auto
# مقادیر زیر قرارداد اتصال آینده‌اند؛ در نسخه محلی استفاده نمی‌شوند.
CUSTOMER_SOURCE=
CATALOG_SOURCE=
PRICING_SOURCE=
INVENTORY_SOURCE=
LLM_PROVIDER=
S3_ENDPOINT=
# بدون مقدار، ورود این نقش‌ها غیرفعال است.
SELLORA_SALES_PASSWORD=
SELLORA_OPERATOR_PASSWORD=
