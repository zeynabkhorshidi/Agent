# development فقط داده آزمایشی؛ production عمداً تا اتصال سرویس‌ها مسدود است.
SELLORA_ENV=development
SELLORA_DB=data/sellora.db
SELLORA_ADMIN_PASSWORD=
COOKIE_SECURE=false
# این فایل را به .env کپی کنید؛ برنامه آن را خودکار می‌خواند.
# تنها بک‌اند به سرویس شرکت متصل می‌شود. این آدرس برای توسعه است.
STT_BASE_URL=http://172.20.3.81:30089
# برای استقرار شرکت، در فایل محیط جداگانه از http://172.20.4.81:30081 استفاده کنید.
# پروتکل HTTP مطابق نمونه uvicorn است؛ TLS ورودی استقرار شرکت باید تأیید شود.
STT_ONLINE_TIMEOUT=45
STT_OFFLINE_TIMEOUT=120
STT_MAX_UPLOAD_MB=25
# مقادیر زیر قرارداد اتصال آینده‌اند؛ در نسخه محلی استفاده نمی‌شوند.
CUSTOMER_SOURCE=
CATALOG_SOURCE=
PRICING_SOURCE=
INVENTORY_SOURCE=
LLM_PROVIDER=
S3_ENDPOINT=
# بدون مقدار، ورود این نقش‌ها غیرفعال است.
SELLORA_SALES_PASSWORD=
SELLORA_OPERATOR_PASSWORD=

# کاتالوگ شرکت؛ واردسازی فقط از داده واقعی دریافت‌شده انجام می‌شود.
CATALOG_URL=https://catalog.sayesaman.com/
# مدل مکالمه سازگار OpenAI؛ نشانی پایه باید شامل نسخه API باشد.
# بدون تنظیم این مقادیر، راهنمای قاعده‌ای فعال می‌ماند.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# سرویس TTS با قرارداد OpenAI-compatible؛ مسیر دقیق را از ارائه‌دهنده بگیرید.
TTS_ENDPOINT=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=
# دریافت خودکار فقط از کاتالوگ شرکت؛ تا دریافت موفق، کالا یا عکس نمونه نمایش داده نمی‌شود.
CATALOG_AUTO_SYNC=true
CATALOG_MAX_PAGES=200
# میزبان CDN عکس فقط اگر واقعاً در سایت دیده و توسط مدیر تأیید شده باشد.
CATALOG_IMAGE_HOSTS=

# اطلاعات ساختگی فقط برای نمایش مشتری قبلی؛ هیچ محصولی ساخته نمی‌شود.
SELLORA_SEED_CUSTOMERS=true
# قرارداد APIهای متریال و فهرست عکس ارسالی شما
CATALOG_MODE=api
CATALOG_SYNC_TIMEOUT=900

# فقط با دیتابیس جدا برای نمایش؛ راه‌انداز start-demo این گزینه را تنظیم می‌کند.
SELLORA_DEMO_MODE=false
